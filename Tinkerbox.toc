Game/Graphics/Graphics.lua
Game/Graphics/GroundClutter.lua
Game/Graphics/ViewDistance.lua
Game/Graphics/ObjectDetail.lua
Game/Graphics/Shadows.lua
Game/Graphics/Sharpening.lua
Game/Graphics/ScreenEffects.lua
Game/Graphics/HDR.lua

Game/Settings/Settings.lua
Game/Settings/Camera.lua
Game/Settings/Nameplates.lua
Game/Settings/Gameplay.lua

Game/Equipment/Equipment.lua
Game/Equipment/SpecSets.lua

